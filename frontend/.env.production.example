# frontend/.env.production.example — the website's build setting (not a secret).
# On the server, before "npm run build":  cp .env.production.example .env.production
#
# The address the website calls for the API. Nginx serves the site and forwards /api to the backend on the
# same domain, so it is the site's own address (no /api, no trailing slash).
VITE_API_URL=https://identee.co.in
