# frontend/.env.production.example — the website's build setting (not a secret).
# On the server, before "npm run build":  cp .env.production.example .env.production
#
# The address the website calls for the API (no /api, no trailing slash). The live backend has its own
# address, backend.identee.co.in. (If the backend were served under the site's own domain at /api instead,
# this would be https://identee.co.in.)
VITE_API_URL=https://backend.identee.co.in
