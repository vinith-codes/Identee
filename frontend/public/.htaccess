# IDENTEE website — settings for an Apache server (the live site runs on Apache).
# It goes into the website folder next to index.html; Vite copies it there in every build.
# (assets/.htaccess, beside the page files, keeps those cached for a year.)
#
# Why (21 Oct 2026): browsers kept YESTERDAY's index.html, which asked for page files a new build no longer has,
# and the server answered those with the home page instead of "not found" — pages broke, "reloaded", lost the
# login and pictures. Now: the start page is always checked for a new version, a missing /assets/ file is a real
# 404 (the site then reloads itself once to get the new version), and every page address still opens the app.
#
# Only directives that every Apache version understands (2.2 and 2.4), each inside <IfModule>.
# If the server ever answers "Internal Server Error" after this file is added, the hosting doesn't allow these
# settings here: delete this file (and assets/.htaccess) and the site works as before.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # http → https (22 Oct 2026: http://identee.co.in opened without the padlock and its login failed, because the
  # backend only accepts the https addresses). The live Apache serves https itself; the X-Forwarded-Proto line stops
  # an endless loop if the hosting ever puts a proxy in front of Apache that handles https.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # one address for the site: www.identee.co.in → identee.co.in (a browser keeps a separate login per address, so
  # opening the www one asked people to log in again).
  RewriteCond %{HTTP_HOST} ^www\.identee\.co\.in$ [NC]
  RewriteRule ^ https://identee.co.in%{REQUEST_URI} [R=301,L]

  # real files and folders are served as they are
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # a file under /assets/ that doesn't exist: "not found" (never the home page in its place)
  RewriteRule ^assets/ - [R=404,L]

  # every other address (/account, /customize/oversized-tee, …) is a page of the website
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # the start page: always ask the server whether there is a newer one
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
