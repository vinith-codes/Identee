# server/.env.example — every setting the IDENTEE backend reads, with NO values.
# On the live server: copy this to server/.env and fill it in yourself (never commit .env, never paste keys in chat).
#   cp .env.example .env   then   nano .env
# Lines marked REQUIRED must be filled for the live site to work.

# ── The server ─────────────────────────────────────────────────────────────
# REQUIRED. "production" on the live server (turns off the dev-only addresses and logs).
NODE_ENV=production
# REQUIRED. The port the backend listens on, inside the server only (Nginx forwards /api to it). Pick a free one.
PORT=3001
# REQUIRED behind Nginx: 1 = trust one proxy, so each customer's real IP is seen (rate limits, logs).
TRUST_PROXY=1
# REQUIRED. The website address(es) allowed to call the API, comma-separated, no trailing slash.
CORS_ORIGIN=https://identee.co.in,https://www.identee.co.in
# REQUIRED. The site's own public address (used for picture links in emails and invoice PDFs).
BACKEND_URL=https://backend.identee.co.in

# ── Login ──────────────────────────────────────────────────────────────────
# REQUIRED. A NEW long random secret for the live server (not the laptop's). Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later logs everyone out (that is all).
JWT_SECRET=
# Optional. "true" to allow login with a phone number (needs SMS_PROVIDER set up).
PHONE_LOGIN_ENABLED=
# Optional. Which SMS service sends phone login codes (leave empty if phone login is off).
SMS_PROVIDER=

# ── Database (MongoDB Atlas) ───────────────────────────────────────────────
# REQUIRED. The connection string. Recommended: a SEPARATE live database, so test orders stay out of it.
# In Atlas → Network Access, add the server's IP address, or the connection is refused.
MONGO_URI=

# ── Pictures (Cloudinary) ──────────────────────────────────────────────────
# REQUIRED. Same account as now (each name once — the laptop's .env has them twice).
CLOUDINARY_NAME=
CLOUDINARY_APIKEY=
CLOUDINARY_SECRETKEY=

# ── Email (Zoho) ───────────────────────────────────────────────────────────
# REQUIRED. Login codes and order emails go out through this account (smtp.zoho.in, port 465).
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
# Optional. The "from" address customers see (defaults to EMAIL_USER).
EMAIL_FROM=

# ── Payments (Razorpay LIVE) ───────────────────────────────────────────────
# REQUIRED for real payments. The LIVE keys (Makaliamman Traders account) — only here, never on the laptop.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED once the webhook is made in the Razorpay dashboard (after the site is live):
#   URL https://backend.identee.co.in/api/orders/razorpay/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# ── AI pictures ────────────────────────────────────────────────────────────
# Needed for "Make a design", Improve my idea, slogans. Without it those features show "coming soon".
IDENTEE_GEMINI_API_KEY=
# Optional. Grok, the backup for photos Google refuses (Admin → Settings → AI designs has its spending cap).
XAI_API_KEY=
# Optional model overrides — leave empty to use the defaults in the code.
AI_IMAGE_MODEL=
AI_TEXT_MODEL=
AI_IDEA_MODEL=
XAI_IMAGE_MODEL=
# Optional. "mock" draws sample pictures without calling any AI (for testing only — never on the live site).
AI_IMAGE_PROVIDER=

# ── GST ────────────────────────────────────────────────────────────────────
# Optional. The shop's state for CGST+SGST vs IGST. Normally taken from the GSTIN in Admin → Settings; else this.
BUSINESS_STATE=

# ── Only for the one-time seed script (server/seeder.js) — not used by the running site ──
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Old / unused by the live site (safe to leave empty) ────────────────────
# FedEx shipping (not wired to checkout), PayPal (old), Stripe (old)
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_AUTH_URL=
FEDEX_API_URL=
FEDEX_SHIP_API_URL=
PAYPAL_CLIENT_ID=
